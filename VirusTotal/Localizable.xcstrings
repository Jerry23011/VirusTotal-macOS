    "Auto Scan only checks files added after it is enabled. Use Scan Existing to check files already in the folder." : {
      "comment" : "A description of the Scan Existing button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Automatické skenování kontroluje pouze soubory přidané po jeho zapnutí. Pomocí volby Skenovat existující zkontrolujete soubory, které už ve složce jsou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Автопроверка проверяет только файлы, добавленные после её включения. Используйте «Проверить существующие», чтобы проверить файлы, которые уже есть в папке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自动扫描只会检查启用后添加的文件。若要检查文件夹中已有的文件，请使用“扫描现有文件”。"
          }
        }
      }
    },
