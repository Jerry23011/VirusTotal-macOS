    "urlview.finalurl.help.details" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konečná URL je adresa, která je na konci všech přesměrování. Může pomoci proti phishingovým útokům."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final URL is the URL that a redirection chain lands on. This can be helpful in detecting phishing attempts or other malicious websites trying to mask their true destination."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конечный URL — это URL-адрес, на который ведет цепочка перенаправлений. Это может быть полезно для обнаружения фишинговых атак или других вредоносных веб-сайтов, пытающихся скрыть свой истинный адрес назначения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最终跳转网址是经过重定向后用户实际访问的页面。此信息有助于识别网络钓鱼攻击或恶意网站掩盖其真实目标的行为"
          }
        }
      }
    },
