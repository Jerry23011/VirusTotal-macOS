            "value" : "Soubory, které VirusTotal ještě nezná, mohou být nahrány. Skenování může spotřebovat významnou část vašeho API limitu a trvat dlouho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
