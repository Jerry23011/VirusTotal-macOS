          }
        }
      }
    },
    "downloadsmonitor.autoscan.alert.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Soubory, které VirusTotal ještě nezná, mohou být automaticky nahrány. Automatické skenování také využívá vaši kvótu API VirusTotal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files not already known to VirusTotal may be uploaded automatically. Auto Scan also uses your VirusTotal API quota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "VirusTotal 尚未知的文件可能会被自动上传。自动扫描还会使用您的 VirusTotal API 配额。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, ещё не известные VirusTotal, могут быть отправлены автоматически. Автопроверка также расходует квоту вашего API-ключа."
          }
        }
      }
    },
    "downloadsmonitor.autoscan.alert.title" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapnout automatické skenování?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Auto Scan?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "启用自动扫描？"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить автопроверку?"
          }
        }
      }
    },
    "downloadsmonitor.autoscan.footnote" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Automatické skenování kontroluje pouze soubory přidané po jeho zapnutí. Funkce Skenovat existující zkontroluje soubory, které už ve složce jsou; neznámé soubory mohou být nahrány do VirusTotal a spotřebovat API limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "自动扫描只会检查启用后添加的文件。“扫描现有文件”会检查文件夹中已有的文件；未知文件可能会上传到 VirusTotal 并消耗 API 配额。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Scan only checks files added after it is enabled. Scan Existing checks files already in the folder; unknown files may be uploaded to VirusTotal and use API quota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автопроверка проверяет только файлы, добавленные после её включения. «Проверить существующие» проверяет файлы, которые уже лежат в папке; неизвестные файлы могут быть отправлены в VirusTotal и израсходовать квоту API."
          }
        }
      }
    },
