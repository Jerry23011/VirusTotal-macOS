    "downloadsmonitor.autoscan.alert.confirm" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zapnout automatické skenování"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Auto Scan"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
